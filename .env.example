# Anthropic credentials. Either export ANTHROPIC_API_KEY, or run `ant auth login`
# and leave this unset - the SDK resolves a stored profile automatically.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults live in evals/config.py)
# EVAL_MODEL=claude-opus-5
# EVAL_EFFORT=medium
# EVAL_CONCURRENCY=8
