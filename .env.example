# ---------------------------------------------------------------------------
# Pick ONE provider. Anthropic is the default; the rest have free tiers.
# ---------------------------------------------------------------------------

# Claude (paid, best quality). Or run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=sk-ant-...

# --- free options ----------------------------------------------------------
# Google Gemini - free tier, no credit card. Key: aistudio.google.com/apikey
# EVAL_PROVIDER=gemini
# GEMINI_API_KEY=...

# Groq - free tier, very fast. Key: console.groq.com/keys
# EVAL_PROVIDER=groq
# GROQ_API_KEY=...

# OpenRouter - free models available. Key: openrouter.ai/keys
# EVAL_PROVIDER=openrouter
# OPENROUTER_API_KEY=...

# Ollama - fully local, no key at all. Install: ollama.com/download
# EVAL_PROVIDER=ollama

# --- optional overrides (defaults live in evals/config.py) -----------------
# EVAL_MODEL=            # defaults to the provider's own default model
# EVAL_EFFORT=medium     # Anthropic only; ignored elsewhere
# EVAL_REPEATS=1
# EVAL_CONCURRENCY=8
# EVAL_BUDGET_USD=5.00
